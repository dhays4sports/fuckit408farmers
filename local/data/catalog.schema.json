{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://408farmers.com/local/data/catalog.schema.json",
  "title": "408FARMERS Local Merchant Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "program", "merchants", "perks"],
  "properties": {
    "schema_version": { "const": "408-local-merchant-v1" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "region", "public_offer_rule", "independent_offer_text", "merchant_relationship_text"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "public_offer_rule": { "type": "string", "minLength": 1 },
        "independent_offer_text": { "type": "string", "minLength": 1 },
        "merchant_relationship_text": { "type": "string", "minLength": 1 }
      }
    },
    "merchants": {
      "type": "array",
      "items": { "$ref": "#/$defs/merchant" }
    },
    "perks": {
      "type": "array",
      "items": { "$ref": "#/$defs/perk" }
    }
  },
  "$defs": {
    "nullableUrl": {
      "anyOf": [
        { "type": "string", "format": "uri", "pattern": "^https://" },
        { "type": "null" }
      ]
    },
    "nullableAsset": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "nullableDateTime": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchant_id", "name", "slug", "category", "neighborhood", "city", "address_display",
        "description_short", "description_long", "website_url", "instagram_url", "image", "logo",
        "status", "featured", "sort_order"
      ],
      "properties": {
        "merchant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 },
        "category": { "enum": ["eat-drink", "home", "auto"] },
        "neighborhood": { "type": "string", "minLength": 1, "maxLength": 80 },
        "city": { "type": "string", "minLength": 1, "maxLength": 80 },
        "address_display": { "type": "string", "minLength": 1, "maxLength": 180 },
        "description_short": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description_long": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "website_url": { "$ref": "#/$defs/nullableUrl" },
        "instagram_url": { "$ref": "#/$defs/nullableUrl" },
        "image": { "$ref": "#/$defs/nullableAsset" },
        "logo": { "$ref": "#/$defs/nullableAsset" },
        "status": { "enum": ["draft", "active", "paused", "inactive"] },
        "featured": { "type": "boolean" },
        "sort_order": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "fixture": { "type": "boolean" }
      }
    },
    "perk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perk_id", "merchant_id", "headline", "summary", "terms", "start_at", "end_at",
        "evergreen", "status", "redemption_method", "independent_offer_text"
      ],
      "properties": {
        "perk_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "merchant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "headline": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 320 },
        "terms": { "type": "string", "minLength": 1, "maxLength": 1600 },
        "start_at": { "$ref": "#/$defs/nullableDateTime" },
        "end_at": { "$ref": "#/$defs/nullableDateTime" },
        "evergreen": { "type": "boolean" },
        "status": { "enum": ["draft", "active", "paused", "inactive"] },
        "redemption_method": { "enum": ["show_screen", "merchant_code", "merchant_instruction"] },
        "independent_offer_text": { "type": "string", "minLength": 1, "maxLength": 400 },
        "fixture": { "type": "boolean" }
      }
    }
  }
}
